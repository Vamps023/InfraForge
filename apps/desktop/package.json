{
  "name": "@infraforge/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "package:win": "npm run build && electron-builder --win nsis --config ../../electron-builder.yml",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.preload.json",
    "test": "vitest run",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "electron": "44.1.1",
    "electron-builder": "^26.0.12",
    "typescript": "7.0.2",
    "vitest": "^5.0.0",
    "electron-builder": "26.0.12"
  }
}
